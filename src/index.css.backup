@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --bg: #f4f6fb;
    --bg-subtle: #eef1f8;
    --bg-card: rgba(255, 255, 255, 0.72);
    --border: rgba(15, 23, 42, 0.1);
    --border-strong: rgba(15, 23, 42, 0.18);
    --text: #0b1220;
    --text-muted: #3d4a63;
    --text-subtle: #647089;
    --accent: #2563eb;
    --accent-2: #6d5efc;
    --accent-soft: rgba(79, 140, 255, 0.12);
    --glass: rgba(255, 255, 255, 0.64);
    --glow-blue: rgba(79, 140, 255, 0.18);
    --glow-violet: rgba(124, 108, 255, 0.14);
  }

  .dark {
    --bg: #05060a;
    --bg-subtle: #0a1020;
    --bg-card: rgba(12, 18, 36, 0.55);
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(159, 184, 255, 0.22);
    --text: #f4f7ff;
    --text-muted: #a9b4ce;
    --text-subtle: #7b869e;
    --accent: #4f8cff;
    --accent-2: #7c6cff;
    --accent-soft: rgba(79, 140, 255, 0.12);
    --glass: rgba(12, 18, 36, 0.55);
    --glow-blue: rgba(79, 140, 255, 0.16);
    --glow-violet: rgba(124, 108, 255, 0.12);
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: Inter, system-ui, sans-serif;
    transition: background-color 0.4s ease, color 0.4s ease;
    overflow-x: hidden;
  }

  ::selection {
    background-color: var(--accent);
    color: #fff;
  }

  h1,
  h2,
  h3,
  h4 {
    letter-spacing: -0.03em;
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 8px;
    border: 2px solid var(--bg);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--text-subtle);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

@layer components {
  .container-page {
    @apply mx-auto w-full max-w-7xl px-5 sm:px-8 lg:px-12;
  }

  .surface-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .glass-panel {
    background: var(--glass);
    border: 1px solid var(--border);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    box-shadow: 0 0 0 1px rgba(124, 108, 255, 0.08), 0 24px 60px rgba(0, 0, 0, 0.18);
  }

  .text-muted {
    color: var(--text-muted);
  }
  .text-subtle {
    color: var(--text-subtle);
  }
  .border-soft {
    border-color: var(--border);
  }
  .border-strong {
    border-color: var(--border-strong);
  }
  .bg-base {
    background-color: var(--bg);
  }
  .bg-subtle {
    background-color: var(--bg-subtle);
  }
  .bg-card {
    background-color: var(--bg-card);
  }

  .bg-grid {
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
  }

  .bg-dots {
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 70% 50% at 50% 50%, #000 30%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 50% at 50% 50%, #000 30%, transparent 80%);
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
  .text-pretty {
    text-wrap: pretty;
  }
  .font-display {
    font-family: Outfit, Inter, system-ui, sans-serif;
  }
}

@layer components {
  .text-gradient {
    background: linear-gradient(120deg, #8db5ff 0%, #4f8cff 45%, #8b7cff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-workspace {
    min-height: 590px;
    isolation: isolate;
  }

  .hero-workspace__ambient {
    position: absolute;
    inset: 10% 4% 8%;
    border-radius: 48px;
    background:
      radial-gradient(circle at 52% 30%, rgba(79, 140, 255, 0.16), transparent 34%),
      radial-gradient(circle at 78% 56%, rgba(124, 108, 255, 0.13), transparent 30%);
    filter: blur(30px);
    z-index: -3;
  }

  .hero-workspace__window {
    position: absolute;
    top: 4%;
    right: 7%;
    width: 63%;
    height: 48%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px 28px 8px 8px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(14, 26, 52, 0.75), rgba(5, 8, 18, 0.92)),
      linear-gradient(135deg, rgba(79, 140, 255, 0.08), transparent);
    box-shadow:
      inset 0 0 60px rgba(79, 140, 255, 0.05),
      0 30px 80px rgba(0, 0, 0, 0.25);
    z-index: -2;
  }

  .hero-workspace__window-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 65% 40%, rgba(79, 140, 255, 0.12), transparent 28%),
      radial-gradient(circle at 30% 70%, rgba(124, 108, 255, 0.08), transparent 24%);
  }

  .hero-workspace__cityline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 31%;
    background:
      linear-gradient(90deg,
        transparent 0 5%,
        rgba(90, 120, 180, 0.16) 5% 11%,
        transparent 11% 15%,
        rgba(90, 120, 180, 0.12) 15% 23%,
        transparent 23% 29%,
        rgba(90, 120, 180, 0.14) 29% 39%,
        transparent 39% 45%,
        rgba(90, 120, 180, 0.12) 45% 53%,
        transparent 53% 59%,
        rgba(90, 120, 180, 0.14) 59% 68%,
        transparent 68% 75%,
        rgba(90, 120, 180, 0.12) 75% 84%,
        transparent 84% 91%,
        rgba(90, 120, 180, 0.13) 91% 100%);
    opacity: 0.8;
  }

  .hero-workspace__city {
    position: absolute;
    top: 10%;
    right: 10%;
    width: 48%;
    height: 34%;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    opacity: 0.28;
    z-index: -1;
  }

  .hero-workspace__city span {
    width: 4px;
    height: 45%;
    border-radius: 999px;
    background: linear-gradient(to bottom, transparent, rgba(120, 155, 220, 0.55));
    box-shadow: 0 0 14px rgba(79, 140, 255, 0.22);
  }

  .hero-workspace__city span:nth-child(2) {
    height: 72%;
  }

  .hero-workspace__city span:nth-child(3) {
    height: 38%;
  }

  .hero-workspace__city span:nth-child(4) {
    height: 84%;
  }

  .hero-workspace__city span:nth-child(5) {
    height: 55%;
  }

  .hero-workspace__city span:nth-child(6) {
    height: 68%;
  }

  .hero-workspace__city span:nth-child(7) {
    height: 42%;
  }

  .hero-workspace__city span:nth-child(8) {
    height: 78%;
  }

  .hero-workspace__wall-copy {
    position: absolute;
    top: 14%;
    left: 4%;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.16);
    transform: rotate(-90deg);
    transform-origin: left top;
    z-index: -1;
  }

  .hero-workspace__desk {
    position: absolute;
    left: 2%;
    right: 0;
    bottom: 3%;
    height: 56%;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background:
      linear-gradient(180deg, rgba(13, 19, 34, 0.78), rgba(7, 10, 19, 0.96)),
      radial-gradient(circle at 45% 0%, rgba(79, 140, 255, 0.08), transparent 45%);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    overflow: visible;
  }

  .hero-workspace__desk::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -12px;
    height: 20px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    filter: blur(12px);
    z-index: -1;
  }

  .hero-workspace__monitor {
    position: absolute;
    left: 9%;
    top: 7%;
    width: 40%;
    height: 44%;
    border: 5px solid rgba(16, 23, 40, 0.95);
    border-radius: 10px;
    background: #060912;
    box-shadow:
      0 15px 35px rgba(0, 0, 0, 0.35),
      0 0 35px rgba(79, 140, 255, 0.06);
  }

  .hero-workspace__monitor-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 7px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .hero-workspace__code {
    padding: 14px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.48);
  }

  .hero-workspace__monitor-stand {
    position: absolute;
    left: 50%;
    bottom: -20%;
    width: 18%;
    height: 20%;
    transform: translateX(-50%);
    background: rgba(18, 25, 42, 0.95);
    clip-path: polygon(35% 0, 65% 0, 78% 100%, 22% 100%);
  }

  .hero-workspace__laptop {
    position: absolute;
    left: 28%;
    bottom: 10%;
    width: 42%;
    height: 38%;
    z-index: 4;
  }

  .hero-workspace__laptop-screen {
    position: absolute;
    left: 8%;
    top: 0;
    width: 84%;
    height: 74%;
    border: 5px solid rgba(13, 20, 35, 0.98);
    border-radius: 9px 9px 4px 4px;
    background: linear-gradient(135deg, #08101d, #0c1220);
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.35);
    padding: 8px;
  }

  .hero-workspace__laptop-base {
    position: absolute;
    bottom: 4%;
    left: 0;
    width: 100%;
    height: 14%;
    border-radius: 3px 3px 13px 13px;
    background: linear-gradient(180deg, #1a2438, #0d1423);
    transform: perspective(100px) rotateX(8deg);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  .hero-workspace__portrait {
    position: absolute;
    right: 7%;
    top: -13%;
    width: 34%;
    z-index: 5;
  }

  .hero-workspace__books {
    position: absolute;
    left: 5%;
    bottom: 4%;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    z-index: 3;
  }

  .hero-workspace__book {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 76px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    background: linear-gradient(145deg, rgba(38, 53, 82, 0.85), rgba(13, 20, 36, 0.95));
    font-family: 'JetBrains Mono', monospace;
    font-size: 7px;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.42);
    writing-mode: vertical-rl;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
  }

  .hero-workspace__notebook {
    position: absolute;
    right: 5%;
    bottom: 4%;
    width: 25%;
    height: 27%;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    background: rgba(216, 222, 235, 0.93);
    transform: rotate(-5deg);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
    color: #172033;
    z-index: 3;
  }

  .hero-workspace__notebook-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero-workspace__notebook-lines {
    margin-top: 9px;
    display: grid;
    gap: 5px;
  }

  .hero-workspace__notebook-lines span {
    display: block;
    height: 1px;
    background: rgba(23, 32, 51, 0.16);
  }

  .hero-workspace__mug {
    position: absolute;
    right: 32%;
    bottom: 6%;
    display: grid;
    place-items: center;
    width: 43px;
    height: 48px;
    border-radius: 5px 5px 12px 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(145deg, #263450, #10182b);
    color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
    z-index: 6;
  }

  .hero-workspace__plant {
    position: absolute;
    right: -1%;
    bottom: 4%;
    width: 65px;
    height: 105px;
    z-index: 3;
  }

  .hero-workspace__plant .leaf {
    position: absolute;
    bottom: 38px;
    left: 50%;
    width: 17px;
    height: 45px;
    border-radius: 100% 0 100% 0;
    background: linear-gradient(145deg, rgba(72, 115, 108, 0.65), rgba(24, 47, 50, 0.9));
    transform-origin: bottom center;
  }

  .hero-workspace__plant .leaf-1 {
    transform: translateX(-50%) rotate(-42deg);
  }

  .hero-workspace__plant .leaf-2 {
    transform: translateX(-50%) rotate(-18deg) scale(0.9);
  }

  .hero-workspace__plant .leaf-3 {
    transform: translateX(-50%) rotate(22deg) scale(0.85);
  }

  .hero-workspace__plant .leaf-4 {
    transform: translateX(-50%) rotate(46deg) scale(0.75);
  }

  .hero-workspace__plant .plant-pot {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 42px;
    height: 34px;
    transform: translateX(-50%);
    border-radius: 4px 4px 12px 12px;
    background: linear-gradient(145deg, #27334a, #101827);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .hero-workspace__floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: rgba(8, 14, 28, 0.7);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
    color: rgba(255, 255, 255, 0.65);
    z-index: 10;
  }

  .hero-workspace__floating-card span,
  .hero-workspace__floating-card strong {
    display: block;
  }

  .hero-workspace__floating-card span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 7px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }

  .hero-workspace__floating-card strong {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.78);
  }

  .hero-workspace__floating-card--api {
    left: 0;
    top: 39%;
  }

  .hero-workspace__floating-card--ai {
    right: 0;
    top: 59%;
  }

  .hero-workspace__idea {
    position: absolute;
    left: 19%;
    top: 2%;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.34);
    z-index: 10;
  }

  .portrait-treatment {
    aspect-ratio: 3 / 4;
  }

  .portrait-treatment__glow {
    position: absolute;
    inset: -18%;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(79, 140, 255, 0.28), transparent 45%),
      radial-gradient(circle at 65% 55%, rgba(124, 108, 255, 0.2), transparent 45%);
    filter: blur(25px);
  }

  .portrait-treatment__frame {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 5px;
    border-radius: 32px 32px 12px 12px;
    background: linear-gradient(
      145deg,
      rgba(126, 169, 255, 0.65),
      rgba(124, 108, 255, 0.22) 42%,
      rgba(255, 255, 255, 0.06)
    );
    box-shadow:
      0 25px 70px rgba(0, 0, 0, 0.45),
      0 0 45px rgba(79, 140, 255, 0.11);
  }

  .portrait-treatment__image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 28px 28px 8px 8px;
    background: #0a1020;
  }

  .portrait-treatment__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 23%;
    filter: contrast(1.05) saturate(0.88) brightness(0.91);
  }

  .portrait-treatment__blue {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      125deg,
      rgba(40, 104, 220, 0.24),
      transparent 42%,
      rgba(69, 55, 172, 0.17)
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .portrait-treatment__violet {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 72% 32%,
      rgba(124, 108, 255, 0.18),
      transparent 38%
    );
    mix-blend-mode: color;
    pointer-events: none;
  }

  .portrait-treatment__grain {
    position: absolute;
    inset: 0;
    opacity: 0.09;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .portrait-treatment__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 55%, rgba(4, 7, 15, 0.4)),
      radial-gradient(ellipse at center, transparent 52%, rgba(4, 7, 15, 0.35));
    pointer-events: none;
  }

  .portrait-treatment__scanline {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 20%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(118, 163, 255, 0.45),
      transparent
    );
    opacity: 0.5;
  }

  .portrait-treatment__corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: rgba(135, 171, 255, 0.55);
    z-index: 8;
  }

  .portrait-treatment__corner--tl {
    left: -8px;
    top: -8px;
    border-left: 1px solid;
    border-top: 1px solid;
  }

  .portrait-treatment__corner--br {
    right: -8px;
    bottom: -8px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }
}

@media (max-width: 1023px) {
  .hero-workspace {
    min-height: 560px;
  }

  .hero-workspace__portrait {
    width: 31%;
  }
}

@media (max-width: 639px) {
  .hero-workspace {
    min-height: 470px;
    transform: scale(0.94);
    transform-origin: top center;
    margin-bottom: -28px;
  }

  .hero-workspace__window {
    right: 5%;
    width: 67%;
    height: 42%;
  }

  .hero-workspace__desk {
    left: 0;
    height: 53%;
  }

  .hero-workspace__monitor {
    left: 5%;
    width: 43%;
  }

  .hero-workspace__laptop {
    left: 25%;
    width: 46%;
  }

  .hero-workspace__portrait {
    right: 5%;
    width: 34%;
    top: -10%;
  }

  .hero-workspace__floating-card {
    transform: scale(0.86);
  }

  .hero-workspace__floating-card--api {
    left: -8px;
    top: 38%;
  }

  .hero-workspace__floating-card--ai {
    right: -8px;
    top: 57%;
  }

  .hero-workspace__notebook {
    width: 26%;
    padding: 8px;
  }

  .hero-workspace__book {
    width: 34px;
    height: 62px;
    font-size: 6px;
  }

  .hero-workspace__mug {
    right: 31%;
    width: 34px;
    height: 39px;
  }

  .hero-workspace__plant {
    transform: scale(0.8);
    transform-origin: bottom right;
  }

  .hero-workspace__idea {
    left: 13%;
    font-size: 7px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-workspace__floating-card {
    transition: none;
  }
}

/* =========================================================
   REFERENCE HERO — PERSONAL DEVELOPER BRAND
   ========================================================= */

.reference-home {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 75% 42%, rgba(79, 140, 255, 0.09), transparent 30%),
    radial-gradient(circle at 48% 78%, rgba(124, 108, 255, 0.08), transparent 28%),
    var(--bg);
}

.reference-hero {
  position: relative;
  min-height: calc(100svh - 96px);
  display: flex;
  align-items: center;
  overflow: hidden;
  isolation: isolate;
}

.reference-hero-grid {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  background-image:
    linear-gradient(rgba(79, 140, 255, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(79, 140, 255, 0.055) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: linear-gradient(to bottom, black 0%, transparent 92%);
  pointer-events: none;
}

.reference-glow {
  position: absolute;
  width: 520px;
  height: 520px;
  border-radius: 999px;
  filter: blur(100px);
  pointer-events: none;
  z-index: -1;
}

.reference-glow-one {
  right: 14%;
  top: 22%;
  background: rgba(79, 140, 255, 0.11);
}

.reference-glow-two {
  left: 26%;
  bottom: 2%;
  background: rgba(124, 108, 255, 0.08);
}

.reference-hero-content {
  position: relative;
  z-index: 2;
  width: min(1440px, calc(100% - 64px));
  min-height: calc(100svh - 96px);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(440px, 0.83fr) minmax(620px, 1.17fr);
  align-items: center;
  gap: 0;
}

.reference-copy {
  position: relative;
  z-index: 5;
  padding: 70px 0 55px;
}

.reference-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 30px;
  color: #c7d3ee;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

.reference-eyebrow-dot {
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
  border-radius: 50%;
  background: linear-gradient(135deg, #8d55ff, #4f8cff);
  box-shadow: 0 0 20px rgba(124, 108, 255, 0.7);
}

.reference-title {
  max-width: 650px;
  margin: 0;
  color: #f7f8ff;
  font-family: 'Outfit', Inter, sans-serif;
  font-size: clamp(3.6rem, 5.2vw, 6.3rem);
  font-weight: 800;
  line-height: 0.92;
  letter-spacing: -0.055em;
}

.reference-title span {
  display: block;
}

.reference-title-accent {
  color: #4f8cff;
}

.reference-title-gradient {
  background: linear-gradient(
    100deg,
    #ffffff 0%,
    #8b5cf6 48%,
    #4f8cff 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.reference-description {
  max-width: 600px;
  margin: 30px 0 0;
  color: #b9c5df;
  font-size: clamp(1rem, 1.2vw, 1.18rem);
  line-height: 1.72;
}

.reference-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 32px;
}

.reference-button {
  min-height: 58px;
  padding: 0 28px;
  border-radius: 15px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
  transition:
    transform 220ms ease,
    box-shadow 220ms ease,
    border-color 220ms ease,
    background 220ms ease;
}

.reference-button:hover {
  transform: translateY(-3px);
}

.reference-button.primary {
  color: white;
  background: linear-gradient(110deg, #8b45ff, #496dff);
  box-shadow: 0 14px 42px rgba(101, 76, 255, 0.28);
}

.reference-button.primary:hover {
  box-shadow: 0 18px 52px rgba(101, 76, 255, 0.4);
}

.reference-button.secondary {
  color: #f4f7ff;
  border: 1px solid rgba(117, 139, 210, 0.4);
  background: rgba(7, 12, 27, 0.45);
  backdrop-filter: blur(14px);
}

.reference-button.secondary:hover {
  border-color: rgba(126, 99, 255, 0.75);
  background: rgba(18, 21, 46, 0.72);
}

.reference-stats {
  display: flex;
  align-items: center;
  margin-top: 50px;
}

.reference-stat {
  position: relative;
  min-width: 145px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.reference-stat strong {
  color: #f7f8ff;
  font-family: 'Outfit', Inter, sans-serif;
  font-size: 30px;
  line-height: 1;
}

.reference-stat span:not(.reference-stat-divider) {
  color: #aebbd5;
  font-size: 14px;
}

.reference-stat-divider {
  position: absolute;
  top: 0;
  right: 28px;
  width: 1px;
  height: 48px;
  background: rgba(141, 158, 204, 0.34);
}

.reference-social {
  margin-top: 38px;
}

.reference-social > span {
  color: #aebbd5;
  font-size: 14px;
}

.reference-social-links {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-top: 14px;
}

.reference-social-links a {
  color: #f4f7ff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition:
    color 180ms ease,
    transform 180ms ease;
}

.reference-social-links a:hover {
  color: #8b6cff;
  transform: translateY(-3px);
}

.reference-social-links .leetcode-link {
  width: 25px;
  height: 25px;
  border: 1px solid rgba(255,255,255,0.65);
  border-radius: 6px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 800;
}

.reference-art {
  position: relative;
  align-self: stretch;
  min-height: 760px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -40px;
}

.reference-art::after {
  content: '';
  position: absolute;
  inset: 5% 0 4% 5%;
  background: radial-gradient(
    ellipse at center,
    rgba(65, 101, 255, 0.16),
    transparent 66%
  );
  filter: blur(35px);
  z-index: -1;
  pointer-events: none;
}

.reference-art-image {
  position: absolute;
  width: 112%;
  height: 108%;
  max-width: none;
  object-fit: cover;
  object-position: center center;
  right: -5%;
  top: -3%;
  border-radius: 26px;
  filter: saturate(1.04) contrast(1.02);
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 9%,
    black 92%,
    transparent 100%
  );
}

.reference-tech-stack {
  position: absolute;
  top: 15%;
  right: 2%;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.reference-tech-card {
  min-width: 178px;
  height: 64px;
  padding: 0 19px;
  display: flex;
  align-items: center;
  gap: 14px;
  border: 1px solid rgba(72, 127, 255, 0.75);
  border-radius: 18px;
  background: rgba(7, 15, 35, 0.82);
  box-shadow:
    0 0 25px rgba(58, 103, 255, 0.13),
    inset 0 0 20px rgba(72, 111, 255, 0.06);
  backdrop-filter: blur(16px);
  color: #f5f7ff;
  font-size: 15px;
  font-weight: 650;
}

.reference-tech-card:nth-child(1) {
  transform: translateX(-38px);
}

.reference-tech-card:nth-child(2) {
  transform: translateX(-15px);
}

.reference-tech-card:nth-child(3) {
  transform: translateX(4px);
}

.reference-tech-card:nth-child(4) {
  transform: translateX(15px);
}

.reference-tech-card:nth-child(5) {
  transform: translateX(35px);
}

.reference-tech-icon {
  width: 30px;
  display: inline-flex;
  justify-content: center;
  font-size: 25px;
}

.reference-quote {
  position: absolute;
  right: 2%;
  bottom: 10%;
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #d6ddf0;
  font-size: 17px;
  line-height: 1.45;
  text-align: right;
}

.reference-quote small {
  margin-top: 10px;
  color: #aab8d3;
  font-size: 13px;
}

.reference-scroll {
  position: absolute;
  left: 50%;
  bottom: 24px;
  z-index: 10;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10px;
  color: #8997b7;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.reference-scroll-arrow {
  width: 30px;
  height: 30px;
  border: 1px solid rgba(130, 102, 255, 0.75);
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #b69cff;
  font-size: 17px;
}

.reference-foundation {
  position: relative;
  z-index: 3;
  width: min(1440px, calc(100% - 64px));
  margin: 0 auto;
  padding: 95px 0 115px;
  border-top: 1px solid rgba(139, 157, 207, 0.13);
}

.reference-section-kicker {
  color: #628cff;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.reference-foundation h2 {
  margin: 8px 0 0;
  color: #f5f7ff;
  font-family: 'Outfit', Inter, sans-serif;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  letter-spacing: -0.04em;
}

.reference-foundation-link {
  position: absolute;
  top: 105px;
  right: 0;
}

.reference-foundation-link a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #8193ba;
  font-size: 12px;
  text-decoration: none;
}

.reference-foundation-link a:hover {
  color: #9c83ff;
}

.reference-foundation-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
  margin-top: 32px;
}

.reference-foundation-card {
  min-height: 92px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1px solid rgba(127, 146, 194, 0.17);
  border-radius: 15px;
  background: rgba(8, 13, 28, 0.5);
  text-decoration: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.reference-foundation-card:hover {
  transform: translateY(-4px);
  border-color: rgba(112, 100, 255, 0.48);
  background: rgba(15, 20, 42, 0.72);
}

.reference-foundation-card span {
  color: #f0f3fb;
  font-size: 14px;
  font-weight: 700;
}

.reference-foundation-card small {
  color: #7e8da9;
  font-size: 11px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {
  .reference-hero-content {
    grid-template-columns: minmax(390px, 0.85fr) minmax(520px, 1.15fr);
    width: min(1180px, calc(100% - 40px));
  }

  .reference-title {
    font-size: clamp(3.3rem, 5.4vw, 5.2rem);
  }

  .reference-art {
    min-height: 700px;
    margin-right: -80px;
  }

  .reference-tech-card {
    min-width: 155px;
  }
}

@media (max-width: 900px) {
  .reference-hero {
    min-height: auto;
  }

  .reference-hero-content {
    min-height: auto;
    grid-template-columns: 1fr;
    padding-top: 35px;
  }

  .reference-copy {
    padding: 55px 0 15px;
  }

  .reference-title {
    max-width: 720px;
    font-size: clamp(3.4rem, 10vw, 5.4rem);
  }

  .reference-description {
    max-width: 650px;
  }

  .reference-art {
    min-height: 650px;
    margin: -10px -80px 0 -100px;
  }

  .reference-tech-stack {
    right: 6%;
    top: 14%;
  }

  .reference-quote {
    right: 7%;
    bottom: 8%;
  }

  .reference-scroll {
    display: none;
  }

  .reference-foundation-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .reference-hero-content,
  .reference-foundation {
    width: min(100% - 32px, 560px);
  }

  .reference-copy {
    padding-top: 38px;
  }

  .reference-eyebrow {
    font-size: 9px;
    letter-spacing: 0.13em;
  }

  .reference-title {
    font-size: clamp(2.75rem, 13vw, 4.2rem);
    line-height: 0.95;
  }

  .reference-description {
    margin-top: 24px;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .reference-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .reference-button {
    width: 100%;
  }

  .reference-stats {
    justify-content: space-between;
    margin-top: 38px;
  }

  .reference-stat {
    min-width: 0;
    flex: 1;
  }

  .reference-stat strong {
    font-size: 23px;
  }

  .reference-stat span:not(.reference-stat-divider) {
    font-size: 11px;
  }

  .reference-stat-divider {
    right: 12px;
    height: 42px;
  }

  .reference-social {
    margin-top: 30px;
  }

  .reference-art {
    min-height: 500px;
    margin: 0 -90px 0 -120px;
  }

  .reference-art-image {
    width: 125%;
    height: 105%;
    right: -12%;
  }

  .reference-tech-stack {
    right: 3%;
    top: 13%;
    gap: 8px;
  }

  .reference-tech-card {
    min-width: 125px;
    height: 46px;
    padding: 0 11px;
    gap: 8px;
    border-radius: 13px;
    font-size: 11px;
  }

  .reference-tech-icon {
    width: 21px;
    font-size: 18px;
  }

  .reference-tech-card:nth-child(1),
  .reference-tech-card:nth-child(2),
  .reference-tech-card:nth-child(3),
  .reference-tech-card:nth-child(4),
  .reference-tech-card:nth-child(5) {
    transform: none;
  }

  .reference-quote {
    display: none;
  }

  .reference-foundation {
    padding: 65px 0 80px;
  }

  .reference-foundation-link {
    position: static;
    margin-top: 15px;
  }

  .reference-foundation-grid {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .reference-button,
  .reference-social-links a,
  .reference-foundation-card {
    transition: none;
  }
}


/* =========================================================
   REFERENCE HERO — FINAL COMPOSITION
   ========================================================= */

.reference-home {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--bg);
}


/* =========================================================
   HERO
   ========================================================= */

.reference-hero {
  position: relative;
  min-height: calc(100svh - 72px);
  display: flex;
  align-items: center;
  overflow: hidden;
  isolation: isolate;
  border-bottom: 1px solid var(--border);
}


/* Background grid */

.reference-hero-grid {
  position: absolute;
  inset: 0;
  z-index: -5;

  background-image:
    linear-gradient(
      to right,
      rgba(79, 140, 255, 0.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgba(79, 140, 255, 0.055) 1px,
      transparent 1px
    );

  background-size: 58px 58px;

  mask-image:
    radial-gradient(
      ellipse 85% 75% at 50% 20%,
      black 20%,
      transparent 82%
    );

  -webkit-mask-image:
    radial-gradient(
      ellipse 85% 75% at 50% 20%,
      black 20%,
      transparent 82%
    );
}


/* Ambient blue glow */

.reference-glow {
  position: absolute;
  pointer-events: none;
  border-radius: 9999px;
  filter: blur(120px);
  z-index: -4;
}

.reference-glow-one {
  width: 480px;
  height: 480px;
  left: 28%;
  top: 5%;
  background: rgba(79, 140, 255, 0.11);
}

.reference-glow-two {
  width: 420px;
  height: 420px;
  right: 3%;
  bottom: 0;
  background: rgba(124, 108, 255, 0.12);
}


/* =========================================================
   TWO COLUMN HERO
   ========================================================= */

.reference-hero-content {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 1440px;

  margin: 0 auto;
  padding: 72px 48px 80px;

  display: grid;
  grid-template-columns:
    minmax(0, 0.88fr)
    minmax(520px, 1.12fr);

  align-items: center;
  gap: 24px;
}


/* =========================================================
   LEFT CONTENT
   ========================================================= */

.reference-copy {
  position: relative;
  z-index: 5;
  max-width: 650px;
}


/* Eyebrow */

.reference-eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;

  margin-bottom: 24px;

  color: #cbd5e1;

  font-family:
    "JetBrains Mono",
    ui-monospace,
    monospace;

  font-size: 12px;
  font-weight: 500;

  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.reference-eyebrow-dot {
  width: 9px;
  height: 9px;
  flex: 0 0 auto;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #7c6cff,
      #4f8cff
    );

  box-shadow:
    0 0 20px rgba(79, 140, 255, 0.65);
}


/* =========================================================
   MAIN HEADLINE
   ========================================================= */

.reference-title {
  display: flex;
  flex-direction: column;

  margin: 0;

  font-family:
    Outfit,
    Inter,
    system-ui,
    sans-serif;

  font-size: clamp(3.7rem, 6.1vw, 6.4rem);

  line-height: 0.91;

  font-weight: 700;

  letter-spacing: -0.065em;

  color: #f8fafc;
}


/* "Systems." */

.reference-title-accent {
  background:
    linear-gradient(
      100deg,
      #70a7ff 0%,
      #4f8cff 45%,
      #7c6cff 100%
    );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}


/* "Creating Impact." */

.reference-title-gradient {
  background:
    linear-gradient(
      100deg,
      #ffffff 0%,
      #c7d2fe 35%,
      #7c6cff 75%,
      #4f8cff 100%
    );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.reference-description {
  max-width: 580px;

  margin-top: 30px;

  color: #b6c1d6;

  font-size: 17px;
  line-height: 1.75;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.reference-actions {
  display: flex;
  align-items: center;
  gap: 18px;

  margin-top: 30px;
}

.reference-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  min-height: 54px;

  padding: 0 26px;

  border-radius: 15px;

  font-size: 15px;
  font-weight: 600;

  text-decoration: none;

  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.reference-button:hover {
  transform: translateY(-2px);
}

.reference-button.primary {
  color: white;

  background:
    linear-gradient(
      110deg,
      #7c3cff,
      #5965ff
    );

  box-shadow:
    0 12px 35px rgba(91, 70, 255, 0.3);
}

.reference-button.primary:hover {
  box-shadow:
    0 16px 42px rgba(91, 70, 255, 0.42);
}

.reference-button.secondary {
  color: #f1f5f9;

  border: 1px solid rgba(148, 163, 184, 0.28);

  background: rgba(7, 12, 24, 0.55);

  backdrop-filter: blur(15px);
}

.reference-button.secondary:hover {
  border-color: rgba(124, 108, 255, 0.55);
}


/* =========================================================
   STATS
   ========================================================= */

.reference-stats {
  display: flex;
  align-items: stretch;

  margin-top: 42px;

  max-width: 540px;
}

.reference-stat {
  position: relative;

  min-width: 145px;

  padding-right: 28px;

  display: flex;
  flex-direction: column;
}

.reference-stat + .reference-stat {
  padding-left: 28px;
}

.reference-stat strong {
  color: #f8fafc;

  font-family:
    Outfit,
    Inter,
    sans-serif;

  font-size: 27px;
  line-height: 1;

  letter-spacing: -0.04em;
}

.reference-stat span:not(.reference-stat-divider) {
  margin-top: 8px;

  color: #8290aa;

  font-size: 12px;

  font-family:
    "JetBrains Mono",
    ui-monospace,
    monospace;

  text-transform: uppercase;

  letter-spacing: 0.05em;
}

.reference-stat-divider {
  position: absolute;

  top: 0;
  right: 0;

  width: 1px;
  height: 48px;

  background: rgba(148, 163, 184, 0.24);
}


/* =========================================================
   SOCIAL
   ========================================================= */

.reference-social {
  margin-top: 34px;
}

.reference-social > span {
  display: block;

  margin-bottom: 13px;

  color: #8f9bb2;

  font-size: 13px;
}

.reference-social-links {
  display: flex;
  align-items: center;
  gap: 18px;
}

.reference-social-links a {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  color: #dbe4f5;

  border-radius: 11px;

  border: 1px solid transparent;

  transition:
    color 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    transform 180ms ease;
}

.reference-social-links a:hover {
  color: white;

  border-color: rgba(124, 108, 255, 0.38);

  background: rgba(124, 108, 255, 0.09);

  transform: translateY(-2px);
}

.leetcode-link {
  font-family:
    "JetBrains Mono",
    monospace;

  font-size: 12px;
  font-weight: 700;
}


/* =========================================================
   RIGHT HERO ART
   ========================================================= */

.reference-art {
  position: relative;

  min-height: 650px;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* Main image frame */

.reference-art-frame {
  position: relative;

  width: min(100%, 860px);

  border-radius: 30px;

  overflow: hidden;

  border: 1px solid rgba(116, 145, 210, 0.28);

  background: #080d1b;

  box-shadow:
    0 35px 100px rgba(0, 0, 0, 0.45),
    0 0 0 1px rgba(79, 140, 255, 0.04),
    0 0 100px rgba(79, 140, 255, 0.08);

  transform: translateX(4%);
}

.reference-art-frame::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      135deg,
      rgba(79, 140, 255, 0.08),
      transparent 35%,
      rgba(124, 108, 255, 0.06)
    );

  mix-blend-mode: screen;
}

.reference-art-image {
  display: block;

  width: 100%;
  height: auto;

  object-fit: cover;

  filter:
    saturate(0.96)
    contrast(1.02);

  transition:
    transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.reference-art-frame:hover .reference-art-image {
  transform: scale(1.015);
}


/* =========================================================
   TECHNOLOGY CARDS
   ========================================================= */

.reference-tech-stack {
  position: absolute;

  inset: 0;

  pointer-events: none;
}

.reference-tech-card {
  position: absolute;

  display: flex;
  align-items: center;
  gap: 12px;

  min-width: 145px;

  padding: 13px 18px;

  border-radius: 18px;

  color: #eef4ff;

  font-size: 14px;
  font-weight: 600;

  border: 1px solid rgba(72, 118, 255, 0.65);

  background:
    linear-gradient(
      135deg,
      rgba(11, 24, 53, 0.94),
      rgba(6, 12, 28, 0.88)
    );

  box-shadow:
    0 15px 35px rgba(0, 0, 0, 0.3),
    0 0 25px rgba(79, 140, 255, 0.08);

  backdrop-filter: blur(18px);

  pointer-events: auto;

  transition:
    transform 220ms ease,
    border-color 220ms ease;
}

.reference-tech-card:hover {
  transform: translateY(-4px);
  border-color: rgba(124, 108, 255, 0.9);
}

.reference-tech-icon {
  width: 29px;
  height: 29px;

  display: grid;
  place-items: center;

  font-size: 20px;
}

.hero-tech-react {
  top: 10%;
  right: 8%;
}

.hero-tech-node {
  top: 24%;
  right: 2%;
}

.hero-tech-python {
  top: 39%;
  right: 0%;
}

.hero-tech-ai {
  top: 54%;
  right: 7%;
}

.hero-tech-system {
  top: 69%;
  right: 2%;
}


/* =========================================================
   QUOTE
   ========================================================= */

.reference-quote {
  position: absolute;

  right: 4%;
  bottom: 2%;

  display: flex;
  flex-direction: column;

  text-align: right;

  color: #cbd5e1;

  font-family:
    Outfit,
    Inter,
    sans-serif;

  font-size: 15px;

  line-height: 1.45;
}

.reference-quote small {
  margin-top: 9px;

  color: #818da5;

  font-family:
    "JetBrains Mono",
    monospace;

  font-size: 10px;
}


/* =========================================================
   SCROLL
   ========================================================= */

.reference-scroll {
  position: absolute;

  left: 50%;
  bottom: 22px;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 10px;

  color: #65728b;

  font-family:
    "JetBrains Mono",
    monospace;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: 0.1em;
}

.reference-scroll-arrow {
  font-size: 15px;

  animation:
    reference-scroll-bounce 1.8s ease-in-out infinite;
}

@keyframes reference-scroll-bounce {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(5px);
  }
}


/* =========================================================
   FOUNDATION
   ========================================================= */

.reference-foundation {
  position: relative;

  max-width: 1440px;

  margin: 0 auto;

  padding: 90px 48px 100px;

  display: grid;

  grid-template-columns: 1fr auto;

  gap: 34px;

  border-bottom: 1px solid var(--border);
}

.reference-section-kicker {
  color: #63718b;

  font-family:
    "JetBrains Mono",
    monospace;

  font-size: 10px;

  letter-spacing: 0.16em;

  text-transform: uppercase;
}

.reference-foundation h2 {
  margin-top: 10px;

  color: #f8fafc;

  font-family:
    Outfit,
    Inter,
    sans-serif;

  font-size: clamp(2rem, 3vw, 3rem);

  letter-spacing: -0.045em;
}

.reference-foundation-link {
  display: flex;
  align-items: center;
}

.reference-foundation-link a {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  color: #94a3b8;

  font-size: 13px;

  text-decoration: none;
}

.reference-foundation-link a:hover {
  color: #ffffff;
}

.reference-foundation-grid {
  grid-column: 1 / -1;

  display: grid;

  grid-template-columns: repeat(5, 1fr);

  gap: 12px;
}

.reference-foundation-card {
  min-height: 90px;

  padding: 20px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  border: 1px solid var(--border);

  border-radius: 16px;

  background: rgba(10, 16, 32, 0.5);

  text-decoration: none;

  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.reference-foundation-card:hover {
  transform: translateY(-3px);

  border-color: rgba(79, 140, 255, 0.4);

  background: rgba(16, 25, 48, 0.7);
}

.reference-foundation-card span {
  color: #e6edf9;

  font-family:
    "JetBrains Mono",
    monospace;

  font-size: 13px;
}

.reference-foundation-card small {
  margin-top: 7px;

  color: #697792;

  font-size: 10px;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1100px) {

  .reference-hero-content {
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);

    padding-left: 32px;
    padding-right: 32px;
  }

  .reference-title {
    font-size: clamp(3.3rem, 6vw, 5rem);
  }

  .reference-art {
    min-height: 570px;
  }

  .reference-tech-card {
    transform: scale(0.9);
    transform-origin: right center;
  }

  .reference-foundation {
    padding-left: 32px;
    padding-right: 32px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {

  .reference-hero {
    min-height: auto;
  }

  .reference-hero-content {
    display: flex;
    flex-direction: column;

    padding:
      52px
      20px
      90px;

    gap: 50px;
  }

  .reference-copy {
    width: 100%;
    max-width: none;
  }

  .reference-title {
    font-size: clamp(3.2rem, 14vw, 5rem);

    line-height: 0.94;
  }

  .reference-description {
    max-width: 620px;

    font-size: 15px;
  }

  .reference-actions {
    flex-wrap: wrap;
  }

  .reference-stats {
    width: 100%;

    justify-content: space-between;
  }

  .reference-stat {
    min-width: 0;
    flex: 1;

    padding-right: 15px;
  }

  .reference-stat + .reference-stat {
    padding-left: 15px;
  }

  .reference-stat strong {
    font-size: 22px;
  }

  .reference-stat span:not(.reference-stat-divider) {
    font-size: 9px;
  }

  .reference-art {
    width: 100%;
    min-height: 500px;
  }

  .reference-art-frame {
    width: 100%;

    transform: none;

    border-radius: 22px;
  }

  .reference-tech-card {
    min-width: 120px;

    padding: 9px 12px;

    font-size: 11px;

    border-radius: 13px;

    transform: scale(0.82);
  }

  .hero-tech-react {
    top: 4%;
    right: 1%;
  }

  .hero-tech-node {
    top: 22%;
    right: -3%;
  }

  .hero-tech-python {
    top: 40%;
    right: -4%;
  }

  .hero-tech-ai {
    top: 58%;
    right: -2%;
  }

  .hero-tech-system {
    top: 76%;
    right: 1%;
  }

  .reference-quote {
    display: none;
  }

  .reference-scroll {
    display: none;
  }

  .reference-foundation {
    display: block;

    padding:
      65px
      20px
      75px;
  }

  .reference-foundation-link {
    margin-top: 18px;
  }

  .reference-foundation-grid {
    margin-top: 30px;

    grid-template-columns: repeat(2, 1fr);
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 480px) {

  .reference-title {
    font-size: clamp(2.8rem, 14vw, 4rem);
  }

  .reference-eyebrow {
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .reference-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .reference-button {
    width: 100%;
  }

  .reference-stats {
    gap: 0;
  }

  .reference-stat strong {
    font-size: 19px;
  }

  .reference-stat span:not(.reference-stat-divider) {
    font-size: 8px;
  }

  .reference-art {
    min-height: 400px;
  }

  .reference-tech-card {
    transform: scale(0.7);
  }

  .reference-foundation-grid {
    grid-template-columns: 1fr;
  }

}

/* =========================================================
   HERO WORKSPACE — FINAL IMAGE FIX
   ========================================================= */

.reference-art {
  position: relative;
  min-height: 650px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reference-art-frame {
  position: relative;
  width: min(100%, 720px);
  aspect-ratio: 3 / 2;
  height: auto;
  overflow: hidden;
  border-radius: 28px;
  background: #080d1b;
  border: 1px solid rgba(116, 145, 210, 0.28);
  box-shadow:
    0 35px 100px rgba(0, 0, 0, 0.45),
    0 0 80px rgba(79, 140, 255, 0.08);
  transform: translateX(4%);
}

.reference-art-image {
  display: block !important;
  position: relative !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  object-fit: cover !important;
  object-position: center center !important;
  border-radius: 0 !important;
  mask-image: none !important;
  filter: saturate(0.96) contrast(1.02);
}

/* Keep technology cards positioned around the image */

.reference-tech-stack {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 10;
}

.reference-tech-card {
  position: absolute;
  pointer-events: auto;
}

/* Desktop card positions */

.hero-tech-react {
  top: 8%;
  right: 4%;
}

.hero-tech-node {
  top: 27%;
  right: -1%;
}

.hero-tech-python {
  top: 46%;
  right: 3%;
}

.hero-tech-ai {
  top: 65%;
  right: 7%;
}

.hero-tech-system {
  top: 83%;
  right: 12%;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {

  .reference-art {
    min-height: auto;
    width: 100%;
  }

  .reference-art-frame {
    width: 100%;
    max-width: 720px;
    aspect-ratio: 3 / 2;
    transform: none;
  }

  .reference-tech-card {
    min-width: 120px;
    padding: 9px 12px;
    font-size: 11px;
    border-radius: 13px;
  }

  .hero-tech-react {
    top: 3%;
    right: 1%;
  }

  .hero-tech-node {
    top: 23%;
    right: -2%;
  }

  .hero-tech-python {
    top: 43%;
    right: -2%;
  }

  .hero-tech-ai {
    top: 63%;
    right: 1%;
  }

  .hero-tech-system {
    top: 82%;
    right: 4%;
  }
}


