/* =========================================================
   FINAL — IMAGE MUST FILL THE ENTIRE HERO FRAME
   ========================================================= */

.reference-art {
  width: 56vw !important;
  max-width: 960px !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
}

.reference-art-frame {
  position: relative !important;

  width: 100% !important;
  max-width: 960px !important;

  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;

  aspect-ratio: 3 / 2 !important;

  display: block !important;

  overflow: hidden !important;

  padding: 0 !important;
  margin: 0 !important;

  border: 1px solid rgba(116, 145, 210, 0.28) !important;
  border-radius: 28px !important;

  background: transparent !important;

  box-sizing: border-box !important;
}

/* FORCE IMAGE TO EXACTLY MATCH FRAME */
.reference-art-frame > img.reference-art-image {
  position: absolute !important;

  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;

  width: 100% !important;
  height: 100% !important;

  min-width: 100% !important;
  min-height: 100% !important;

  max-width: none !important;
  max-height: none !important;

  aspect-ratio: auto !important;

  display: block !important;

  margin: 0 !important;
  padding: 0 !important;

  box-sizing: border-box !important;

  object-fit: fill !important;
  object-position: center !important;

  border: 0 !important;
  border-radius: 28px !important;

  transform: none !important;

  filter: none !important;

  mask: none !important;
  mask-image: none !important;
  -webkit-mask: none !important;
  -webkit-mask-image: none !important;
}

/* REMOVE ANY INNER FRAME EFFECT */
.reference-art-frame::before,
.reference-art-frame::after {
  content: none !important;
  display: none !important;
}

/* Disable old image sizing rules */
.reference-art img {
  max-width: none !important;
  max-height: none !important;
}

/* =========================================================
   DESKTOP — BIGGER HERO
   ========================================================= */

@media (min-width: 1200px) {
  .reference-art {
    width: 58vw !important;
    max-width: 960px !important;
  }

  .reference-art-frame {
    width: 100% !important;
    max-width: 960px !important;
    aspect-ratio: 3 / 2 !important;
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (min-width: 801px) and (max-width: 1199px) {
  .reference-art {
    width: 52vw !important;
    max-width: 800px !important;
  }

  .reference-art-frame {
    width: 100% !important;
    max-width: 800px !important;
    aspect-ratio: 3 / 2 !important;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .reference-art {
    width: 100% !important;
    max-width: 100% !important;
  }

  .reference-art-frame {
    width: 100% !important;
    max-width: 100% !important;
    aspect-ratio: 3 / 2 !important;
    border-radius: 22px !important;
  }

  .reference-art-frame > img.reference-art-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: fill !important;
    border-radius: 22px !important;
  }
}

/* =========================================================
   END — FULL IMAGE / FULL FRAME
   ========================================================= */

